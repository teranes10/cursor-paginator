<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>CursorPaginator</PackageId>
    <Version>1.0.0</Version>
    <Authors>teranesranjith</Authors>
    <Company>teranesranjith</Company>
    <Description>A high-performance, source-generated Cursor-Based Pagination and Dynamic Filtering library for .NET and Dapper. Generates strongly-typed SQL queries, binary serialization jump tables, and HMAC-SHA256 signed cursors at compile time via Roslyn Source Generators.</Description>
    <Summary>Cursor-based pagination and dynamic filtering for .NET with compile-time SQL generation.</Summary>
    <PackageTags>cursor;pagination;dapper;sql;source-generator;dotnet;filtering</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/teranes10/cursor-paginator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teranes10/cursor-paginator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 teranesranjith</Copyright>

    <!-- Symbol package for debugging support -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Condition="Exists('../README.md')" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md') and !Exists('../README.md')" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" Condition="Exists('../LICENSE')" />
    <None Include="icon.png" Pack="true" PackagePath="/" Condition="Exists('icon.png')" />
  </ItemGroup>

</Project>
