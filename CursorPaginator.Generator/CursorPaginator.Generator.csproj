<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- The generator DLL must ship under analyzers/dotnet/cs, not lib/, or MSBuild
         won't load it as an analyzer for consumers -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <!-- NuGet Package Metadata -->
    <PackageId>CursorPaginator.Generator</PackageId>
    <Version>1.1.0</Version>
    <Authors>teranesranjith</Authors>
    <Company>teranesranjith</Company>
    <Description>Roslyn Source Generator for CursorPaginator — generates strongly-typed SQL queries, binary serialization jump tables, and HMAC-SHA256 signed cursors at compile time for high-performance cursor-based pagination with Dapper.</Description>
    <Summary>Compile-time source generator for CursorPaginator.</Summary>
    <PackageTags>cursor;pagination;dapper;sql;source-generator;roslyn;analyzer;dotnet;filtering</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/teranes10/cursor-paginator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teranes10/cursor-paginator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 teranesranjith</Copyright>

    <!-- Mark as dev-only so it does not appear as a runtime dependency -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Symbol package for debugging support -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <!-- The generator references the main library for its types/attributes -->
  <ItemGroup>
    <ProjectReference Include="../CursorPaginator/CursorPaginator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases\*.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Condition="Exists('../README.md')" />
    <None Include="../CursorPaginator/README.md" Pack="true" PackagePath="/" Condition="Exists('../CursorPaginator/README.md') and !Exists('../README.md')" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" Condition="Exists('../LICENSE')" />
    <None Include="../CursorPaginator/icon.png" Pack="true" PackagePath="/" Condition="Exists('../CursorPaginator/icon.png')" />
  </ItemGroup>

  <!-- Ship the generator DLL under analyzers/dotnet/cs so MSBuild loads it as an
       analyzer instead of adding it as a normal compile reference. CursorPaginator.dll
       must ship alongside it in the same folder — the generator loads it at runtime
       inside its isolated AssemblyLoadContext, and consumers' own CursorPaginator
       PackageReference lives in a different load context that the analyzer can't see. -->
  <Target Name="AddGeneratorDllToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(OutputPath)CursorPaginator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <!-- IncludeBuildOutput=false also drops the pdb from the snupkg; re-add it
           explicitly so the symbol package isn't empty -->
      <None Include="$(OutputPath)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    </ItemGroup>
  </Target>

</Project>